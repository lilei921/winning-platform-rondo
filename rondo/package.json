{
  "name": "@winning/rondo",
  "version": "1.2.52",
  "description": "面向 Multica 研发交付的确定性 CLI，提供交付校验、执行、事实管理及平台运维能力。",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rondo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "build:exe": "node scripts/build-exe.mjs",
    "prepack": "npm run build && node scripts/copy-schemas.mjs",
    "pack": "npm pack",
    "test": "node --test test/*.test.mjs \"dist/**/*.test.js\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.19"
  },
  "dependencies": {
    "azure-devops-node-api": "^6.6.2",
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "marked": "^17.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "openspec/schemas",
    "README.md",
    "COMMANDS.md"
  ]
}
