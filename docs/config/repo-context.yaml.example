# 所有已接入子仓的全量清单；repo-context.yaml 是主要面向本地已存在子仓的子集。
# 按 repo_id 合并本地条目，保留本地未选入的仓库；维护规则见 README.md。
# 运行时只读取 repo-context.yaml，不自动加载本文件。
# 这里只保存身份、职责边界、关键词和可选 TFS 归属，不保存构建或 MCP 状态。
# 路由与跨服务入口见 docs/router/overview.md；构建与技术栈到目标仓核实。
# 旧风险与依赖仅供追溯：projects/analysis/repo-context-retired-metadata-2026-10-20.yaml。
version: 0.4.0
schema:
  required_fields: [repo_id, repo_type, repo_path, responsibility, keywords, not_responsible_for]
  optional_fields: [repo_url, tfs_project, tfs_collection]
  repo_type_values: [root-workspace, common, backend, frontend]

repos:
  - repo_id: root
    repo_type: root-workspace
    repo_path: .
    repo_url: http://tfs2018-web.winning.com.cn:8080/tfs/WN_Data_Platform/DP-01-%E6%95%B0%E6%8D%AE%E4%BB%93%E5%BA%93/_git/winning-platform-monorepo
    responsibility: AI coding、agent、docs、openspec、graph、wiki 与共享工具等资产。
    keywords: [AI coding, Agent, docs, openspec, graph, wiki]
    not_responsible_for: [具体业务实现]
    tfs_project: DP-01-数据仓库
    tfs_collection: WN_Data_Platform

  - repo_id: common
    repo_type: common
    repo_path: winning-dps-df-common
    repo_url: http://tfs2018-web.winning.com.cn:8080/tfs/WN_Data_Platform/WiNEX%20DataFactory/_git/winning-dps-df-common
    responsibility: 通用实体、常量、DTO、枚举、工具和共享基础代码。
    keywords: [公共, 通用, 实体, 常量, 工具, 共享, 枚举, DTO]
    not_responsible_for: [具体服务业务流程]
    tfs_project: WiNEX DataFactory
    tfs_collection: WN_Data_Platform

  - repo_id: frame
    repo_type: backend
